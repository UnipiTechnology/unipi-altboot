# Upstream definition — the single source of truth for the build and
# for the SBOM component generator. Sourced by prepare.sh and parsed by
# debian/scripts/gen-component-sbom.
#
# unipi-altboot bundles three upstream projects, fetched by prepare.sh at
# the refs below into busybox/, swupdate/ and ttyd/. These were previously
# git submodules; pinning explicit refs here gives reproducible, NVD-matchable
# builds. busybox and swupdate pin to release tags; ttyd pins to the former
# submodule commit (a main snapshot between releases).
#
# <NAME>_REF     : the git ref prepare.sh fetches (exact source pin — a release
#                  tag, a commit SHA, or a branch). Set to the release tag when
#                  it matches <NAME>_VERSION (swupdate); to a commit SHA to pin
#                  an unreleased snapshot (busybox 1_36_1, ttyd at the former
#                  submodule commit); or to a branch to track upstream.
# <NAME>_VERSION : the version reported in the SBOM for CPE/purl matching —
#                  the latest release at or before the pin.
# <NAME>_REPO    : the upstream git repository (also the CPE/purl ancestry)
# <NAME>_HOMEPAGE: the upstream homepage
#
# NVD CPEs (verified):
#   busybox  -> cpe:2.3:a:busybox:busybox
#   swupdate -> cpe:2.3:a:swupdate:swupdate
#   ttyd     -> cpe:2.3:a:ttyd_project:ttyd

BUSYBOX_REF=1_38_0
BUSYBOX_VERSION=1.38.0
BUSYBOX_REPO=https://github.com/vda-linux/busybox_mirror.git
BUSYBOX_HOMEPAGE=https://busybox.net/

SWUPDATE_VERSION=2025.12
SWUPDATE_REPO=https://github.com/sbabic/swupdate.git
SWUPDATE_HOMEPAGE=https://swupdate.org/

# Pinned to the former git submodule commit (a main snapshot between
# 1.7.7 and the next release); 1.7.7 is the latest release for NVD matching.
TTYD_REF=eccebc6bb1dfbaf0c46f1fd9c53b89abc773784d
TTYD_VERSION=1.7.7
TTYD_REPO=https://github.com/tsl0922/ttyd.git
TTYD_HOMEPAGE=https://tsl0922.github.io/ttyd/
